# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin of this deployment, no trailing slash. Twilio signature
# validation reconstructs the signed URL from this value, so it MUST match the
# URL you configured on the Twilio number exactly (scheme + host).
# Local dev: your ngrok https URL. Production: https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Use the *session* pooler / direct connection string from
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Serverless note: the pooler (port 6543) is recommended for Vercel.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only. Used by the seed script and admin user provisioning. Never expose.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Optional: use an API key pair instead of the auth token for REST calls.
# The auth token is still required for webhook signature validation.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Optional: Messaging Service SID. Strongly recommended for A2P 10DLC — when
# set, outbound SMS is sent from the service instead of a bare number.
TWILIO_MESSAGING_SERVICE_SID=

# LOCAL DEV ONLY. Set to "true" to bypass X-Twilio-Signature validation.
# Ignored (hard-disabled) whenever NODE_ENV=production.
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error. Defaults to info. Phone numbers are redacted and
# credentials are stripped at every level.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Seed script (npm run seed)
# ---------------------------------------------------------------------------
SEED_CLIENT_NAME="Demo Plumbing Co"
SEED_BUSINESS_PHONE=+15551234567
SEED_TWILIO_NUMBER=+15557654321
SEED_TIMEZONE=America/New_York
SEED_OWNER_EMAIL=owner@example.com
